{
  "manifest_version": 3,
  "name": "Literature Monitor Browser Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "description": "Secure loopback handoff for Literature Monitor in normal Chrome.",
  "incognito": "not_allowed",
  "permissions": ["storage", "tabs", "webNavigation", "downloads"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://resolver.ebsco.com/*", "https://research.ebsco.com/*"],
  "background": {"service_worker": "service_worker.js"},
  "action": {"default_title": "Literature Monitor current task", "default_popup": "task_popup.html"},
  "content_scripts": [{
    "matches": ["http://localhost/browser-handoff/*", "http://127.0.0.1/browser-handoff/*"],
    "include_globs": [
      "http://localhost*/browser-handoff/????????-????-????-????-????????????*",
      "http://127.0.0.1*/browser-handoff/????????-????-????-????-????????????*"
    ],
    "js": ["handoff_protocol.js", "handoff_content.js"],
    "all_frames": false,
    "run_at": "document_idle"
  }, {
    "matches": ["https://resolver.ebsco.com/c/45yels/result*", "https://resolver.ebsco.com/redirect?*"],
    "js": ["handoff_protocol.js", "acquisition_protocol.js", "resolver_content.js"],
    "all_frames": false,
    "run_at": "document_idle"
  }, {
    "matches": ["https://research.ebsco.com/c/*/search/details/*"],
    "js": ["acquisition_protocol.js", "ebsco_record_content.js"],
    "all_frames": false,
    "run_at": "document_idle"
  }]
}
