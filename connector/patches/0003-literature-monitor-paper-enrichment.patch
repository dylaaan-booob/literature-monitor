+
+// Guard the actual sandbox instance, after translator loading, before RPC dispatch.
+async function literatureMonitorTranslateReadOnly(translate, metadata) {
+	const translator = new Zotero.Translator(metadata);
+	if (metadata.runMode !== Zotero.Translator.RUN_MODE_IN_BROWSER || translator.runMode !== Zotero.Translator.RUN_MODE_IN_BROWSER) {
+		throw new Error("Paper enrichment requires a browser Translator");
+	}
+	const loaded = translate._translateTranslatorLoaded;
+	translate._translateTranslatorLoaded = function() {
+		if (this.translator[0].runMode !== Zotero.Translator.RUN_MODE_IN_BROWSER) {
+			throw new Error("Remote translation is forbidden for Paper enrichment");
+		}
+		return Zotero.Translate.Base.prototype._translateTranslatorLoaded.call(this);
+	};
+	try {
+		await translate.setTranslator(translator);
+		translate.setHandler('select', () => { throw new Error("Multiple Items are not supported"); });
+		return await translate.translate({libraryID: false, saveAttachments: false});
+	} finally {
+		translate._translateTranslatorLoaded = loaded;
+	}
+}
