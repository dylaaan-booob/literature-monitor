+// Keep absent components absent. Only the Python writer supplies compatibility 01s.
+function literatureMonitorDateParts(value) {
+	if (typeof value !== "string" || !value.trim()) return null;
+	try {
+		const parsed = Zotero.Date.strToDate(value);
+		if (!/^\d{1,4}$/.test(String(parsed.year)) || parsed.part?.trim()) return null;
+		if (parsed.order.includes("m") && !Number.isInteger(parsed.month)) return null;
+		if (parsed.order.includes("d") && (!Number.isInteger(parsed.day) || parsed.day < 1)) return null;
+		// strToDate swaps oversized numeric months; never repair an explicit year-first date.
+		const numeric = value.trim().match(/^\d{4}[-/.](\d{1,2})(?:[-/.](\d{1,2}))?$/);
+		if (numeric && (Number(numeric[1]) !== parsed.month + 1
+			|| (numeric[2] !== undefined && Number(numeric[2]) !== parsed.day))) return null;
+		const parts = {year: Number(parsed.year)};
+		if (Number.isInteger(parsed.month)) parts.month = parsed.month + 1;
+		if (Number.isInteger(parsed.day)) parts.day = parsed.day;
+		return parts;
+	} catch (_) { return null; }
+}
